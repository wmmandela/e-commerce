{
  "regions": ["bom1"],
  "buildCommand": "npm run build",
  "devCommand": "npm run dev --workspace frontend -- --host 0.0.0.0 --port $PORT",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index?path=$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
